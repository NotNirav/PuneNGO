# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Optional: only needed if you want persistent cloud DB/Storage) ---
# The demo prototype works 100% out-of-the-box with ZERO keys required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel ---
ADMIN_PATH=/admin                 # URL path for admin (default: /admin)
ADMIN_USERNAME=pccoeadmin         # Admin username (default: pccoeadmin)
ADMIN_PASSWORD=admin@123          # Admin password (default: admin@123)
ADMIN_PASSWORD_HASH=              # Optional scrypt hash
ADMIN_SESSION_SECRET=             # Signing secret for admin session cookies

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
